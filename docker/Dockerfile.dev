FROM python:3.12-slim

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    BZL_ORIS_CACHE_DIR=/var/cache/bzl

WORKDIR /web

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

# Dev image gets the unpinned requirements plus the tooling from pyproject.
COPY ./docker/requirements.txt requirements.txt
COPY ./pyproject.toml pyproject.toml
RUN python -m pip install --upgrade pip uv \
    && uv pip install --no-cache-dir -r requirements.txt \
    && uv pip install --no-cache-dir mypy pandas-stubs pytest ruff types-requests

RUN mkdir -p "$BZL_ORIS_CACHE_DIR"

COPY . .

EXPOSE 5099
